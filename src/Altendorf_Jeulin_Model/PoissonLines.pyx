def simulate_poisson_lines(
    mu: float,
    R,
    direction_distribution,
    image_size,
    seed: int = None,
    is_poisson: bool = True,
    volume_fraction_should: float = 1.0,
):
    """
    Generate a system of endless line segments following a Poisson line process.

    Each line is generated by generate_poisson_line and clipped to the
    observation window.  Generation stops early if the estimated volume
    fraction exceeds volume_fraction_should.

    :param mu: float
        mean number of lines; used as the Poisson rate when is_poisson=True,
        or as an exact count when is_poisson=False
    :param R: float or random variable
        line radius; passed to set_value for each line
    :param direction_distribution: callable
        function (rng) -> (mu_x, mu_y, mu_z) returning a unit direction
        vector for each line
    :param image_size: array-like of shape (3,)
        dimensions of the observation window in voxels (x, y, z)
    :param seed: int or None, optional
        seed for the random number generator; default None (random)
    :param is_poisson: bool, optional (default: True)
        if True, draw the number of lines from Poisson(mu);
        if False, use mu as an exact integer count
    :param volume_fraction_should: float, optional (default 1.0)
        maximum volume fraction; generation stops early once exceeded;
        default 1.0 (no early stopping)
    :return: list[list]
        list of [pos1, pos2, r_line] entries, where pos1 and pos2 are
        np.ndarray endpoint coordinates in voxel space and r_line is the
        line radius
    """
    rng = default_rng(seed)
    if is_poisson:
        n = poisson(mu).rvs(random_state=rng)
    else:
        n = int(mu)
    line_system = []
    vol = 0
    image_vol = image_size[0] * image_size[1] * image_size[2]
    for i in range(0, n):
        # 1. Simulate the radius of the ith fiber
        r_line = set_value(R, rng)
        # 2. Generate Poisson line
        pos1, pos2, _, _, length = generate_poisson_line(
            rng, direction_distribution, image_size
        )
        pos1 *= np.array(image_size)
        pos2 *= np.array(image_size)

        # create list of end points and radius
        if length > -1:
            line_system.append([pos1, pos2, r_line])
            vol += length * r_line**2 * np.pi * image_size[0]
            volume_fraction_is = vol / image_vol
            if volume_fraction_is > volume_fraction_should:
                break
    print("Volume fraction ", str(vol / image_vol))
    return line_system


def generate_poisson_line(
    rng, direction_distribution, image_size
):
    """
    Generate a single Poisson line within the unit cube, then scale to image_size.

    A direction mu0 is sampled from direction_distribution.  A line position
    is then drawn uniformly over the disk perpendicular to mu0 (radius 3/2)
    using rejection sampling.  The line is intersected with the unit cube via
    line_cut_cube; if it misses, length is -1.  The midpoint is scaled to
    voxel coordinates by image_size.

    :param rng: numpy.random.Generator
        random number generator
    :param direction_distribution: callable
        function (rng) -> (mu_x, mu_y, mu_z) returning a unit direction
    :param image_size: array-like of shape (3,)
        dimensions of the observation window in voxels; used to scale
        the midpoint from unit-cube to voxel coordinates
    :return: tuple
        (start_pos, end_pos, mid_pos, mu0, length) where start_pos and
        end_pos are unit-cube intersection points (np.ndarray), mid_pos is
        the midpoint scaled to voxel coordinates (np.ndarray), mu0 is the
        unit direction vector (np.ndarray), and length is the chord length
        in unit-cube coordinates or -1 if the line misses the cube
    """
    cdef double r, theta0, phi0
    # 2. Simulate the mean orientation (Schladitz distribution)
    mu0_x, mu0_y, mu0_z = direction_distribution(rng)
    mu0 = np.array([mu0_x, mu0_y, mu0_z])
    cartesian_to_spherical(mu0_x, mu0_y, mu0_z, &r, &theta0, &phi0)
    # 3. Generate Poisson line
    rho = 3/2 * np.sqrt(rng.random())
    phi = 2 * PI * rng.random()
    u1 = rho * cos(phi)
    u2 = rho * sin(phi)
    lp_x = cos(theta0) * cos(phi0)* u1 - sin(phi0)*u2 + 0.5
    lp_y = cos(theta0)*sin(phi0)*u1 + cos(phi0)*u2 + 0.5
    lp_z = 0.5 - sin(theta0)*u1
    linepos = np.array([lp_x, lp_y, lp_z])
    # 4. if it cuts 2 planes, calculate midpoint
    is_cut, start_pos, end_pos, mid_pos, length = line_cut_cube(linepos, mu0)
    mid_pos = mid_pos * np.array(image_size)
    return start_pos, end_pos, mid_pos, mu0, length


def line_cut_sphere_length(linepos: np.ndarray, mu0: np.ndarray):
    """
    Compute the chord length of a line through a sphere of radius sqrt(3)/2
    centred at the origin.

    Solves the quadratic |linepos + lambda*mu0|^2 = 3/4 for lambda and
    returns the distance between the two intersection points.

    :param linepos: np.ndarray, shape (3,)
        a point on the line (the line's closest approach to the origin)
    :param mu0: np.ndarray, shape (3,)
        unit direction vector of the line
    :return: float or int
        chord length if the line intersects the sphere, or -1 if it misses
    """

    B = 2 * np.dot(linepos, mu0)
    C = np.dot(linepos, linepos) - 3 / 4
    if B**2 - 4 * C < 0:
        return -1
    lambd1 = (-B + np.sqrt(B**2 - 4 * C)) / 2
    p1 = linepos + lambd1 * mu0
    lambd2 = (-B - np.sqrt(B**2 - 4 * C)) / 2
    p2 = linepos + lambd2 * mu0
    return np.linalg.norm(p2 - p1)


def line_cut_cube(linepos: np.ndarray, mu0):
    """
    Compute the intersection of an infinite line with the unit cube [0,1]^3.

    Tests all six faces of the cube via line_cut_face.  Duplicate
    intersection points (corners, edges) are deduplicated.  Returns the
    two distinct entry and exit points when the line crosses the cube,
    or a failure sentinel otherwise.

    :param linepos: np.ndarray, shape (3,)
        a point on the line
    :param mu0: np.ndarray, shape (3,)
        direction vector of the line (need not be unit length)
    :return: tuple (is_cut, start_pos, end_pos, mid_pos, length)
        is_cut (bool): True if the line crosses the cube interior
        start_pos (np.ndarray): first intersection point
        end_pos (np.ndarray): second intersection point
        mid_pos (np.ndarray): midpoint (start_pos + end_pos) / 2
        length (float): Euclidean distance between the two intersections,
            or -1 if the line misses the cube
    """
    face_normals = [
        np.array([1, 0, 0]),
        np.array([1, 0, 0]),
        np.array([0, 1, 0]),
        np.array([0, 1, 0]),
        np.array([0, 0, 1]),
        np.array([0, 0, 1]),
    ]
    intersections = []
    for i, normal in enumerate(face_normals):
        dist = 1 if i % 2 == 0 else 0
        intersection = line_cut_face(normal, dist, linepos, mu0)
        if (
            intersection[0] >= 0
            and intersection[0] <= 1
            and intersection[1] >= 0
            and intersection[1] <= 1
            and intersection[2] >= 0
            and intersection[2] <= 1
        ):
            # Deduplicate: skip if this point is already recorded
            if not any(np.allclose(intersection, p, atol=1e-10) for p in intersections):
                intersections.append(intersection)
    if len(intersections) == 2:
        return (
            True,
            intersections[0],
            intersections[1],
            (intersections[0] + intersections[1]) / 2,
            np.linalg.norm(intersections[0] - intersections[1]),
        )
    else:
        return False, np.array([0, 0, 0]), np.array([0, 0, 0]), np.array([0, 0, 0]), -1


def line_cut_face(
    face_normal: np.ndarray, face_dist: int, linepos: np.ndarray, mu0: np.ndarray
):
    """
    Compute the intersection of an infinite line with a single face of the
    unit cube.

    The face is defined by the plane face_normal^ T x = face_dist.
    If the line is parallel to the face (dot product ≈ 0), returns the
    sentinel (2, 2, 2) which lies outside [0,1]^3 and is filtered out by
    line_cut_cube.

    :param face_normal: np.ndarray, shape (3,)
        outward normal of the face, e.g. (1, 0, 0) for the x-faces
    :param face_dist: int
        plane offset; 0 for the near face, 1 for the far face
    :param linepos: np.ndarray, shape (3,)
        a point on the line
    :param mu0: np.ndarray, shape (3,)
        direction vector of the line
    :return: np.ndarray, shape (3,)
        intersection point, or (2, 2, 2) if the line is parallel to the face
    """
    cdef double cosi = face_normal[0]*mu0[0] + face_normal[1]*mu0[1] + face_normal[2]*mu0[2]
    cdef double other_dot, lambd
    if np.isclose(cosi, 0):
        return np.array([2, 2, 2])  # TODO ok?
    else:
        other_dot = face_normal[0]*linepos[0] + face_normal[1]*linepos[1] + face_normal[2]*linepos[2]
        lambd = (face_dist - other_dot) / cosi
        return linepos + lambd * mu0


def generate_half_fiber(
    mu0: np.ndarray,
    mid_pos: np.ndarray,
    image_size,
    kappa1,
    kappa2,
    r_fiber,
    coords: list[np.ndarray],
    rng,
    is_forward: bool,
):
    """
    Grow one half of an endless fiber by a von Mises–Fisher random walk.

    Starting from mid_pos, steps of length r_fiber/2 are taken until the
    current position leaves the extended image domain.  Each step direction
    is drawn from vonmises_fisher with a local mean that blends the global
    direction mu0 (weighted by kappa1) and the previous step direction
    (weighted by kappa2).

    The forward half (is_forward=True) appends new positions to the end of
    coords; the backward half (is_forward=False) prepends them to the front,
    so that coords remains ordered from one end of the fiber to the other.

    :param mu0: np.ndarray, shape (3,)
        global mean direction unit vector of the fiber
    :param mid_pos: np.ndarray, shape (3,)
        starting position (the Poisson line midpoint) in voxel coordinates
    :param image_size: array-like of shape (3,)
        dimensions of the extended domain; the walk stops when the current
        position leaves is_in_image(pos, image_size, 0)
    :param kappa1: float
        weight of the global mean direction mu0 in each random-walk step;
        higher values pull steps toward mu0
    :param kappa2: float
        weight of the previous step direction; higher values increase
        local persistence (straighter fibers)
    :param r_fiber: float
        fiber radius; step length is r_fiber / 2
    :param coords: list[np.ndarray]
        coordinate list to extend; must contain at least the midpoint on
        entry; modified in place and also returned
    :param rng: numpy.random.Generator
        random number generator
    :param is_forward: bool
        if True, grow in the direction of mu0 (append to end of coords);
        if False, grow in the direction of -mu0 (prepend to front of coords)
    :return: list[np.ndarray]
        the extended coords list with all new positions added
    """
    cdef double mu0_x, mu0_y, mu0_z, mu_old_x, mu_old_y, mu_old_z, mu_new_x, mu_new_y, mu_new_z
    cdef double current_pos_x, current_pos_y, current_pos_z
    cdef int sign
    if is_forward:
        sign = 1
    else:
        sign = -1
    mu0_x = mu0[0]
    mu0_y = mu0[1]
    mu0_z = mu0[2]
    mu_old_x = sign*mu0_x
    mu_old_y = sign*mu0_y
    mu_old_z = sign*mu0_z
    current_pos_x = mid_pos[0]
    current_pos_y = mid_pos[1]
    current_pos_z = mid_pos[2]

    while is_in_image(np.array([current_pos_x, current_pos_y, current_pos_z]), image_size, 0):
        mu_new_x = sign*kappa1*mu0_x + kappa2*mu_old_x
        mu_new_y = sign*kappa1*mu0_y + kappa2*mu_old_y
        mu_new_z = sign*kappa1*mu0_z + kappa2*mu_old_z
        kappa_new = cnormalized(&mu_new_x, &mu_new_y, &mu_new_z)
        mu_old_x, mu_old_y, mu_old_z = vonmises_fisher(kappa_new, mu_new_x, mu_new_y, mu_new_z, rng)
        current_pos_x += r_fiber * mu_old_x / 2
        current_pos_y += r_fiber * mu_old_y / 2
        current_pos_z += r_fiber * mu_old_z / 2
        if is_forward:
            coords.append(np.array([current_pos_x, current_pos_y, current_pos_z]))
        else:
            coords.insert(0, np.array([current_pos_x, current_pos_y, current_pos_z]))
    return coords
